    "typecheck": "pnpm --recursive --if-present typecheck",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "oxfmt": "^0.73.0",
    "oxlint": "^1.20.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
