# 将此文件复制为项目根目录的 .env，再填写百炼 API Key。
DASHSCOPE_API_KEY=
# 默认使用华北 2（北京）地域；如果 Key 属于其他地域，请改成对应的兼容接口地址。
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# 网页搜索工具由 Tavily 提供；需要自动搜索时再填写这个 Key。
TAVILY_API_KEY=

# 腾讯云实时语音识别；从腾讯云 API 密钥管理获取 AppID、SecretId 和 SecretKey。
TENCENT_ASR_APP_ID=
TENCENT_ASR_SECRET_ID=
TENCENT_ASR_SECRET_KEY=
