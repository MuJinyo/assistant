# 将此文件复制为项目根目录的 .env，再填写百炼 API Key。
DASHSCOPE_API_KEY=
# 默认使用华北 2（北京）地域；如果 Key 属于其他地域，请改成对应的兼容接口地址。
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# 网页搜索工具由 Tavily 提供；需要自动搜索时再填写这个 Key。
TAVILY_API_KEY=

# 腾讯云实时语音识别；从腾讯云 API 密钥管理获取 AppID、SecretId 和 SecretKey。
TENCENT_ASR_APP_ID=
TENCENT_ASR_SECRET_ID=
TENCENT_ASR_SECRET_KEY=

# 火山引擎 WebSocket TTS；旧版控制台使用 AppID 和 Access Token。
VOLCENGINE_TTS_APP_ID=你的AppID
VOLCENGINE_TTS_ACCESS_TOKEN=你的AccessToken
# 资源 ID 必须和 voice_type 所属模型版本匹配。
VOLCENGINE_TTS_RESOURCE_ID=seed-tts-1.0
# 示例为 Mars 系列音色；请替换成已开通的 voice_type。
VOLCENGINE_TTS_VOICE_TYPE=zh_female_kefunvsheng_mars_bigtts
# 音频编码，当前网页播放按 mp3 配置。
VOLCENGINE_TTS_ENCODING=mp3
